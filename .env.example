# ─── Required ────────────────────────────────────────────────────────

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# MongoDB connection string. For local dev:
#   mongodb://localhost:27017/reppod
# For MongoDB Atlas:
#   mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/reppod?retryWrites=true&w=majority
MONGODB_URI=

# Set to true when deploying on Vercel / behind a proxy (required for Auth.js).
AUTH_TRUST_HOST=true

# ─── Optional: Google OAuth ──────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Leave these empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional: Billing (Dodo Payments — recommended for Pakistan) ────
# Merchant of Record: handles global tax + shows each buyer their local
# currency. Leave empty for mock mode. When set, Dodo takes priority.
#   API key:  dodopayments.com dashboard → Developer → API Keys
#   Mode:     "test" or "live"
#   Webhook:  Developer → Webhooks → URL /api/billing/webhook (copy the secret)
#   Products: create one product per plan+cycle, paste each product_id below
DODO_API_KEY=
DODO_MODE=test
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_YEARLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_STUDIO_MONTHLY=
DODO_PRODUCT_STUDIO_YEARLY=

# ─── Optional: Billing (LemonSqueezy) ───────────────────────────────
# Leave empty to run billing in mock/demo mode (simulated checkout, no real
# payment). Add real keys to switch to live checkout — no code changes needed.
#   API key:   lemonsqueezy.com → Settings → API
#   Store ID:  Settings → Stores (the number)
#   Webhook:   Settings → Webhooks → callback URL /api/billing/webhook,
#              events: subscription_created/updated/cancelled/expired
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs per plan+cycle (Products → your product → each variant's ID).
# Only fill in the plans you actually sell.
LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=
LEMONSQUEEZY_VARIANT_STARTER_YEARLY=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_STUDIO_MONTHLY=
LEMONSQUEEZY_VARIANT_STUDIO_YEARLY=

# ─── Optional: Cloudinary (avatar & photo uploads) ──────────────────
# Sign up free at https://cloudinary.com, then create an UNSIGNED upload
# preset (Settings → Upload). Leave empty to fall back to initials avatars.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── Auth.js URL (only needed if you deploy behind a proxy) ──────────
# AUTH_URL=http://localhost:3000
