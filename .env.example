# ─── Required ────────────────────────────────────────────────────────

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# MongoDB connection string. For local dev:
#   mongodb://localhost:27017/reppod
# For MongoDB Atlas:
#   mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/reppod?retryWrites=true&w=majority
MONGODB_URI=

# Set to true when deploying on Vercel / behind a proxy (required for Auth.js).
AUTH_TRUST_HOST=true

# ─── Optional: Google OAuth ──────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Leave these empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional: Cloudinary (avatar & photo uploads) ──────────────────
# Sign up free at https://cloudinary.com, then create an UNSIGNED upload
# preset (Settings → Upload). Restrict the preset to the `reppod` folder,
# JPG/PNG/WebP/AVIF + MP4/WebM/MOV, 10 MB images, and 50 MB videos.
# These provider-side restrictions are required; browser checks can be bypassed.
# Leave empty to fall back to initials avatars.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── Auth.js URL (only needed if you deploy behind a proxy) ──────────
# AUTH_URL=http://localhost:3000
