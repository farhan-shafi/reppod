# ─── Required ────────────────────────────────────────────────────────

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# MongoDB connection string. For local dev:
#   mongodb://localhost:27017/flexflow
# For MongoDB Atlas (recommended for portfolio demo):
#   mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/flexflow?retryWrites=true&w=majority
MONGODB_URI=

# ─── Optional: Google OAuth ──────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Leave these empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional: Billing (LemonSqueezy) ───────────────────────────────
# Leave empty to run billing in mock/demo mode (simulated checkout, no real
# payment). Add real keys to switch to live checkout without code changes.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ─── Optional: Cloudinary (avatar & photo uploads) ──────────────────
# Sign up free at https://cloudinary.com, then create an UNSIGNED upload
# preset (Settings → Upload). Leave empty to fall back to initials avatars.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── Auth.js URL (only needed if you deploy behind a proxy) ──────────
# AUTH_URL=http://localhost:3000
